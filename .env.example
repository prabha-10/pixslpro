# Copy this file to .env.local and fill in the values.
# All keys are NEXT_PUBLIC_* because they're read in the browser/build.

# Public site URL, no trailing slash. Used for canonical URLs, sitemap, robots, and OG images.
NEXT_PUBLIC_SITE_URL=https://pixsl.pro

# Booking link for the /contact page (Calendly or Cal.com embed URL).
# If left blank, the contact page falls back to a mailto button.
NEXT_PUBLIC_BOOKING_URL=

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable analytics.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content value of the
# google-site-verification meta tag). Leave blank until you verify the property.
NEXT_PUBLIC_GSC_VERIFICATION=
